<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="TodoistSuite">
  <listeners>
    <listener class-name="com.ejemplo.todoist.utils.TestListener" />
  </listeners>

  <test name="Flujo Login y Crear Tarea" preserve-order="true">
    <classes>
      <class name="com.ejemplo.todoist.tests.LoginTest"/>
      <class name="com.ejemplo.todoist.tests.CreateTaskTest"/>
    </classes>
  </test>

  <test name="Login Fallido" preserve-order="true">
    <classes>
      <class name="com.ejemplo.todoist.tests.LoginFail"/>
    </classes>
  </test>
</suite>

