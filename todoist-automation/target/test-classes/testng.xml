<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="TodoistSuite">
  <listeners>
    <listener class-name="com.ejemplo.todoist.utils.TestListener" />
  </listeners>

  <test name="Login Test">
    <classes>
      <class name="com.ejemplo.todoist.tests.LoginTest"/>
